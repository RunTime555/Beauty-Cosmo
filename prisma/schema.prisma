generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Category {
  Skincare
  Fragrance
  Makeup
  Cleanser
}

enum StockStatus {
  In_Stock
  Low_Stock
  Pre_Order
}

enum SaleStatus {
  Completed
  Pending
  Refunded
}

enum Role {
  ADMIN
  SELLER
}

// Mirrors Supabase auth.users so we can join/display sellers and manage
// roles from our own DB. id MUST match the Supabase auth user id.
model User {
  id        String   @id
  email     String   @unique
  name      String?
  role      Role     @default(SELLER)
  createdAt DateTime @default(now())

  sales     Sale[]
}

// Singleton table (always id = 1) holding store-wide configuration.
model StoreSettings {
  id             Int      @id @default(1)
  storeName      String   @default("Beauty Cosmo Retail")
  taxRate        Float    @default(8.0)
  currencySymbol String   @default("$")
  updatedAt      DateTime @updatedAt
}

model Product {
  id            String      @id @default(uuid())
  name          String
  category      Category
  sku           String      @unique
  costPrice     Float
  sellingPrice  Float
  stockQuantity Int
  status        StockStatus @default(In_Stock)
  imageUrl      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  saleItems     SaleItem[]
}

model Sale {
  id          String     @id @default(uuid())
  totalAmount Float
  taxAmount   Float
  sellerName  String
  sellerId    String?
  status      SaleStatus @default(Completed)
  createdAt   DateTime   @default(now())

  seller      User?      @relation(fields: [sellerId], references: [id])
  items       SaleItem[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Int
  price     Float

  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}